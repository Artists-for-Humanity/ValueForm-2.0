{
  "name": "value-form-chris_pross",
  "version": "2.0.0",
  "description": "Artist For Humanity Client Work- ValueForm Christopher Pross",
  "main": "script.js",
  "scripts": {
    "start": "node server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rimraf dist && mkdirp dist && cpx \"pages/**/*\" dist/pages && cpx index.html dist && cpx \"css/**/*\" dist/css && cpx \"images/**/*\" dist/images && mkdirp dist/scripts && cpx \"scripts/*\" dist/scripts",
    "serve": "nodemon server.js",
    "watch": "chokidar \"pages/**/*\" \"css/**/*\" \"images/**/*\" \"scripts/**/*\" \"index.html\" -c \"npm run build\"",
    "dev": "npm-run-all build --parallel serve watch",
    "vercel-build": "npm run build",
    "check-node": "node -v"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.3",
    "express": "^4.20.0",
    "path-to-regexp": "^8.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "send": "^0.19.0",
    "serve-static": "^1.16.2",
    "styled-components": "^6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "babel-loader": "^9.1.3",
    "chokidar-cli": "^3.0.0",
    "connect-livereload": "^0.6.1",
    "cpx": "^1.5.0",
    "livereload": "^0.10.3",
    "mkdirp": "^3.0.1",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4"
  }
}
